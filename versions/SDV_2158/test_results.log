        child_table_data = {'parent_id': [], 'col_B': [], 'col_C': []}
    
        for i in range(num_rows):
            num_children = np.random.choice([0, 1, 10, 15], p=[0.4, 0.5, 0.05, 0.05])
            if num_children == 0:
                continue
            child_table_data['parent_id'].extend([i] * num_children)
