            max_diff: str = "1e-6",
            same_key_length=True,
    ) -> None:
        """Compares serialized dicts so that serialized numbers can be compared for equality"""
    
        if same_key_length:
            assert len(a) == len(b), f"Dicts don't have the same key length {len(a)} != {len(b)}"
