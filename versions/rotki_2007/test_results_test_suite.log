      // è½¬ä¹ i18n å ä½ç¬¦ {'xxx'} -> xxx
      const unescapeI18n = function(text) {
        if (!text) return null;
        return text
          .replace(/\{'\|'\}/g, "|")
          .replace(/\{'@'\}/g, "@")
          .replace(/\{'\$'\}/g, "$");
      };

      // ä¿®æ¹é¡µé¢æ é¢
      const changePageTitle = function(locale) {
        window.TMS.load({
