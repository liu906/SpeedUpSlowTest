                    f'Cryptocompare returned invalid JSON response: {response.text}',
                ) from e
    
            try:
                if json_ret.get('Message', None) == RATE_LIMIT_MSG:
                    if tries >= 1:
                        backoff_seconds = 20 / tries
                        log.debug(
