                                    system=scoring_systems["cvssv3"], value=cvss3_base_score
                                ),
                                VulnerabilitySeverity(
                                    system=scoring_systems["cvssv3_vector"], value=cvss3_vector
                                ),
                            ]
                        )
                references.append(Reference(url=link, severities=severities))
    
            advisories.append(
                Advisory(
