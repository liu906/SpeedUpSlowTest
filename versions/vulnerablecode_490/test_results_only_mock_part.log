            summary = desc_col.text
            pkg_qualifiers = {}
            if "windows" in summary.lower():
                pkg_qualifiers = {"os": "windows"}
    
            affected_packages = [
                PackageURL(
                    type="generic",
                    name="postgresql",
                    version=version.strip(),
                    qualifiers=pkg_qualifiers,
                )
                for version in affected_col.text.split(",")
            ]
    
            fixed_packages = [
                PackageURL(
                    type="generic",
