            affected_packages = [
                PackageURL(
                    type="generic",
                    name="postgresql",
                    version=version.strip(),
                    qualifiers=pkg_qualifiers,
                )
                for version in affected_col.text.split(",")
            ]
    
            fixed_packages = [
